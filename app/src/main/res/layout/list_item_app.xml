<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="wrap_content"
     android:layout_width="match_parent"
     android:layout_marginVertical="6dp"
     android:layout_marginHorizontal="12dp"
     app:cardElevation="2dp"
     app:cardUseCompatPadding="true"
     app:cardCornerRadius="12dp"
     android:foreground="?attr/selectableItemBackground">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:background="@drawable/item_background"
         android:padding="16dp"
         android:orientation="horizontal">

        <FrameLayout
             android:layout_height="56dp"
             android:layout_width="56dp"
             android:layout_marginEnd="16dp">

            <ImageView
                 android:layout_height="56dp"
                 android:layout_width="56dp"
                 android:scaleType="centerCrop"
                 android:background="@drawable/icon_background"
                 android:padding="2dp"
                 android:id="@+id/appIconImageView" />

            <TextView
                 android:layout_height="16dp"
                 android:layout_width="16dp"
                 android:visibility="gone"
                 android:background="@drawable/warning_badge"
                 android:gravity="center"
                 android:textSize="10sp"
                 android:textColor="@android:color/white"
                 android:id="@+id/warningBadge"
                 android:layout_gravity="top|end"
                 android:text="!"
                 android:textStyle="bold" />

        </FrameLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:orientation="vertical"
             android:layout_weight="1">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:background="?attr/selectableItemBackground"
                 android:clickable="true"
                 android:textSize="16sp"
                 android:textColor="@color/blue"
                 android:focusable="true"
                 android:id="@+id/appNameTextView"
                 android:text="App Name"
                 android:textStyle="bold" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:gravity="center_vertical"
                 android:orientation="horizontal"
                 android:layout_marginTop="2dp">

                <ImageView
                     android:layout_height="14dp"
                     android:layout_width="14dp"
                     android:layout_marginEnd="4dp"
                     android:src="@android:drawable/ic_menu_info_details"
                     android:tint="@color/secondary_text" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:ellipsize="end"
                     android:textSize="13sp"
                     android:textColor="@color/secondary_text"
                     android:maxLines="1"
                     android:id="@+id/appDetailsTextView"
                     android:text="com.example.packagename" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:visibility="gone"
                 android:gravity="center_vertical"
                 android:background="@drawable/warning_background"
                 android:paddingVertical="4dp"
                 android:orientation="horizontal"
                 android:layout_marginTop="6dp"
                 android:paddingHorizontal="8dp"
                 android:id="@+id/warningLayout">

                <ImageView
                     android:layout_height="14dp"
                     android:layout_width="14dp"
                     android:layout_marginEnd="6dp"
                     android:src="@android:drawable/stat_notify_error"
                     android:tint="@color/warning_red" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="12sp"
                     android:fontFamily="sans-serif-medium"
                     android:textColor="@color/warning_red"
                     android:id="@+id/warningTextView"
                     android:text="Potential Adware Detected!"
                     android:textStyle="normal" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
             android:layout_height="36dp"
             android:layout_width="wrap_content"
             app:icon="@android:drawable/ic_menu_add"
             app:iconSize="16dp"
             android:textSize="12sp"
             app:cornerRadius="18dp"
             style="@style/Widget.Material3.Button.OutlinedButton"
             app:iconPadding="4dp"
             android:layout_marginStart="12dp"
             android:id="@+id/addwatchlistButton"
             android:layout_gravity="center_vertical"
             android:text="Watchlist" />

    </LinearLayout>

</androidx.cardview.widget.CardView>